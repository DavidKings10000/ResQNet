generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  CITIZEN
  DISPATCHER
  AMBULANCE
  POLICE
  FIRE
  HOSPITAL
  ADMIN
}

enum IncidentStatus {
  REPORTED
  TRIAGED
  DISPATCHED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum BlockchainAction {
  INCIDENT_CREATED
  DISPATCHED
  STATUS_CHANGED
  HANDOFF_CONFIRMED
  COMPLETED
}

model Role {
  id          String   @id @default(cuid())
  name        RoleName  @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roles")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  fullName        String
  phone           String?
  isActive        Boolean   @default(true)
  isVerified      Boolean   @default(false)
  roleId          String
  role            Role      @relation(fields: [roleId], references: [id])
  citizen         Citizen?
  ambulance       Ambulance?
  hospital        Hospital?
  fireStation     FireStation?
  policeStation   PoliceStation?
  notifications   Notification[]
  messagesSent    Message[] @relation("MessageSender")
  messagesReceived Message[] @relation("MessageReceiver")
  emergencyReports EmergencyReport[]
  dispatchRecords DispatchRecord[]
  auditLogs       AuditLog[]
  aiResults       AIResult[]
  blockchainLogs  BlockchainLog[]
  mediaUploads    MediaUpload[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([email])
  @@index([roleId])
  @@map("users")
}

model Citizen {
  id              String            @id @default(cuid())
  userId          String            @unique
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  address         String?
  latitude        Decimal?          @db.Decimal(9, 6)
  longitude       Decimal?          @db.Decimal(9, 6)
  emergencyReports EmergencyReport[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@map("citizens")
}

model EmergencyReport {
  id                String            @id @default(cuid())
  reportNumber      String            @unique
  citizenId         String
  citizen           Citizen           @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  reporterUserId    String
  reporterUser      User              @relation(fields: [reporterUserId], references: [id], onDelete: Cascade)
  emergencyType     String
  description       String
  latitude          Decimal           @db.Decimal(9, 6)
  longitude         Decimal           @db.Decimal(9, 6)
  address           String?
  status            IncidentStatus    @default(REPORTED)
  priority          PriorityLevel     @default(MEDIUM)
  severityScore     Int               @default(0)
  riskLevel         String?
  resourceRequirement String?
  estimatedResponseTime Int?
  hospitalRecommendation String?
  possibleDuplicate Boolean           @default(false)
  possibleFalseReport Boolean          @default(false)
  massCasualtyEvent Boolean           @default(false)
  dispatchRecords   DispatchRecord[]
  aiResults         AIResult[]
  blockchainLogs    BlockchainLog[]
  messages          Message[]
  mediaUploads      MediaUpload[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([status])
  @@index([priority])
  @@index([citizenId])
  @@index([reporterUserId])
  @@map("emergency_reports")
}

model DispatchRecord {
  id               String           @id @default(cuid())
  emergencyReportId String
  emergencyReport  EmergencyReport  @relation(fields: [emergencyReportId], references: [id], onDelete: Cascade)
  dispatcherUserId String
  dispatcherUser   User             @relation(fields: [dispatcherUserId], references: [id], onDelete: Cascade)
  ambulanceId      String?
  ambulance        Ambulance?       @relation(fields: [ambulanceId], references: [id])
  hospitalId       String?
  hospital         Hospital?        @relation(fields: [hospitalId], references: [id])
  fireStationId    String?
  fireStation      FireStation?     @relation(fields: [fireStationId], references: [id])
  policeStationId  String?
  policeStation    PoliceStation?   @relation(fields: [policeStationId], references: [id])
  assignedAt       DateTime         @default(now())
  etaMinutes       Int?
  status           IncidentStatus   @default(DISPATCHED)
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([emergencyReportId])
  @@index([dispatcherUserId])
  @@map("dispatch_records")
}

model Ambulance {
  id               String           @id @default(cuid())
  registrationNumber String          @unique
  vehicleType      String
  currentLatitude  Decimal?         @db.Decimal(9, 6)
  currentLongitude Decimal?         @db.Decimal(9, 6)
  isAvailable      Boolean          @default(true)
  assignedUserId   String?          @unique
  assignedUser     User?            @relation(fields: [assignedUserId], references: [id])
  hospitalId       String?
  hospital         Hospital?        @relation(fields: [hospitalId], references: [id])
  dispatchRecords  DispatchRecord[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([isAvailable])
  @@map("ambulances")
}

model FireStation {
  id                String            @id @default(cuid())
  name              String
  address           String?
  latitude          Decimal?          @db.Decimal(9, 6)
  longitude         Decimal?          @db.Decimal(9, 6)
  assignedUserId    String?           @unique
  assignedUser      User?             @relation(fields: [assignedUserId], references: [id])
  dispatchRecords   DispatchRecord[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@map("fire_stations")
}

model PoliceStation {
  id                String            @id @default(cuid())
  name              String
  address           String?
  latitude          Decimal?          @db.Decimal(9, 6)
  longitude         Decimal?          @db.Decimal(9, 6)
  assignedUserId    String?           @unique
  assignedUser      User?             @relation(fields: [assignedUserId], references: [id])
  dispatchRecords   DispatchRecord[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@map("police_stations")
}

model Hospital {
  id                String            @id @default(cuid())
  name              String
  address           String?
  latitude          Decimal?          @db.Decimal(9, 6)
  longitude         Decimal?          @db.Decimal(9, 6)
  phone             String?
  assignedUserId    String?           @unique
  assignedUser      User?             @relation(fields: [assignedUserId], references: [id])
  beds              HospitalBed[]
  ambulances        Ambulance[]
  dispatchRecords   DispatchRecord[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@map("hospitals")
}

model HospitalBed {
  id              String    @id @default(cuid())
  hospitalId      String
  hospital        Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  bedNumber       String
  bedType         String    @default("GENERAL")
  isOccupied      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([hospitalId, bedNumber])
  @@index([hospitalId])
  @@map("hospital_beds")
}

model Notification {
  id                 String               @id @default(cuid())
  recipientUserId    String
  recipientUser      User                 @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  emergencyReportId  String?
  emergencyReport    EmergencyReport?     @relation(fields: [emergencyReportId], references: [id])
  channel            NotificationChannel
  status             NotificationStatus   @default(PENDING)
  message            String
  metadata           String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([recipientUserId])
  @@index([status])
  @@map("notifications")
}

model AIResult {
  id                String            @id @default(cuid())
  emergencyReportId String
  emergencyReport   EmergencyReport   @relation(fields: [emergencyReportId], references: [id], onDelete: Cascade)
  modelName         String
  severityScore     Int
  priorityLevel     PriorityLevel
  riskLevel         String
  resourceRequirement String
  estimatedResponseTime Int
  hospitalRecommendation String
  duplicatePossible  Boolean           @default(false)
  falseReportPossible Boolean         @default(false)
  massCasualtyEvent Boolean           @default(false)
  createdByUserId   String?
  createdByUser     User?             @relation(fields: [createdByUserId], references: [id])
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([emergencyReportId])
  @@map("ai_results")
}

model BlockchainLog {
  id                String            @id @default(cuid())
  emergencyReportId String
  emergencyReport   EmergencyReport   @relation(fields: [emergencyReportId], references: [id], onDelete: Cascade)
  action            BlockchainAction
  txHash            String?
  metadata          String?
  createdByUserId   String?
  createdByUser     User?             @relation(fields: [createdByUserId], references: [id])
  createdAt         DateTime          @default(now())

  @@index([emergencyReportId])
  @@map("blockchain_logs")
}

model AuditLog {
  id                String            @id @default(cuid())
  userId            String?
  user              User?             @relation(fields: [userId], references: [id])
  emergencyReportId String?
  emergencyReport   EmergencyReport?  @relation(fields: [emergencyReportId], references: [id])
  action            String
  details           String?
  createdAt         DateTime          @default(now())

  @@index([userId])
  @@index([emergencyReportId])
  @@map("audit_logs")
}

model Message {
  id                 String            @id @default(cuid())
  senderUserId       String
  senderUser         User              @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  recipientUserId    String
  recipientUser      User              @relation("MessageReceiver", fields: [recipientUserId], references: [id], onDelete: Cascade)
  emergencyReportId  String?
  emergencyReport    EmergencyReport?  @relation(fields: [emergencyReportId], references: [id])
  content            String
  isRead             Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([senderUserId])
  @@index([recipientUserId])
  @@map("messages")
}

model MediaUpload {
  id                String            @id @default(cuid())
  emergencyReportId String
  emergencyReport   EmergencyReport   @relation(fields: [emergencyReportId], references: [id], onDelete: Cascade)
  uploadedByUserId  String
  uploadedByUser    User              @relation(fields: [uploadedByUserId], references: [id], onDelete: Cascade)
  fileName          String
  url               String
  mimeType          String
  mediaType         MediaType
  sizeBytes         Int
  createdAt         DateTime          @default(now())

  @@index([emergencyReportId])
  @@map("media_uploads")
}

model Setting {
  id         String   @id @default(cuid())
  key        String   @unique
  value      String
  description String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("settings")
}
